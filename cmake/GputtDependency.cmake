# Find an installed gpuTT, use a local checkout, or fetch a pinned fork revision.
include_guard(GLOBAL)

option(GPUTT_AUTO_FETCH "Fetch and build if find_package fails" ON)
set(GPUTT_SOURCE_DIR "" CACHE PATH "Path to local gpuTT source directory")
set(GPUTT_GIT_REPO "https://github.com/Edric-Matwiejew/gputt.git" CACHE STRING "gpuTT repository")
set(GPUTT_GIT_TAG "fe512f410c074a8ef0fe7d6c1709c082ae18fe4f" CACHE STRING "gpuTT commit or release tag")
option(GPUTT_BUILD_PYTHON "Build gpuTT Python bindings" OFF)

if(CMAKE_HIP_PLATFORM STREQUAL "nvidia")
  set(GPUTT_BACKEND CUDA CACHE STRING "gpuTT backend" FORCE)
  if(NOT CMAKE_CUDA_ARCHITECTURES)
    set(CMAKE_CUDA_ARCHITECTURES "${CMAKE_HIP_ARCHITECTURES}")
  endif()
  if(NOT CMAKE_CUDA_COMPILER)
    set(CMAKE_CUDA_COMPILER "${CMAKE_HIP_COMPILER}")
  endif()
  if(CMAKE_HIP_HOST_COMPILER AND NOT CMAKE_CUDA_HOST_COMPILER)
    set(CMAKE_CUDA_HOST_COMPILER "${CMAKE_HIP_HOST_COMPILER}")
  endif()
else()
  set(GPUTT_BACKEND HIP CACHE STRING "gpuTT backend" FORCE)
endif()

# Keep dependency binaries local to this build, even with shared source downloads.
set(_gputt_build_dir "${PROJECT_BINARY_DIR}/_deps/gputt-build")
if(GPUTT_SOURCE_DIR)
  add_subdirectory("${GPUTT_SOURCE_DIR}" "${_gputt_build_dir}" EXCLUDE_FROM_ALL)
  set(GPUTT_PROVIDER local)
else()
  find_package(gputt CONFIG QUIET)
  if(gputt_FOUND)
    set(GPUTT_PROVIDER system)
  else()
    if(NOT GPUTT_AUTO_FETCH)
      message(FATAL_ERROR "gpuTT not found; set gputt_DIR or GPUTT_SOURCE_DIR, or enable GPUTT_AUTO_FETCH")
    endif()
    if(NOT GPUTT_GIT_TAG)
      message(FATAL_ERROR "Set GPUTT_GIT_TAG to a published fork commit/release, or GPUTT_SOURCE_DIR to a local checkout")
    endif()
    include(FetchContent)
    FetchContent_Declare(gputt
      GIT_REPOSITORY "${GPUTT_GIT_REPO}"
      GIT_TAG "${GPUTT_GIT_TAG}"
      BINARY_DIR "${_gputt_build_dir}"
      UPDATE_DISCONNECTED TRUE
    )
    FetchContent_MakeAvailable(gputt)
    set(GPUTT_PROVIDER fetched)
  endif()
endif()

if(NOT TARGET gputt::gputt)
  message(FATAL_ERROR "gpuTT must provide the gputt::gputt target; use the maintained fork")
endif()
if(DEFINED gputt_BACKEND AND NOT gputt_BACKEND STREQUAL GPUTT_BACKEND)
  message(FATAL_ERROR "Installed gpuTT backend ${gputt_BACKEND} does not match ${GPUTT_BACKEND}")
endif()
if(NOT TARGET gputt)
  add_library(gputt ALIAS gputt::gputt)
endif()

# Retained for callers that used the dependency module's include/version variables.
get_target_property(GPUTT_INCLUDE_DIR gputt::gputt INTERFACE_INCLUDE_DIRECTORIES)
if(gputt_VERSION)
  set(GPUTT_VERSION "${gputt_VERSION}")
elseif(GPUTT_PROVIDER STREQUAL "fetched")
  set(GPUTT_VERSION "${GPUTT_GIT_TAG}")
else()
  set(GPUTT_VERSION local)
endif()
