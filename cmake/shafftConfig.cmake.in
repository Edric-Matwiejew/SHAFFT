@PACKAGE_INIT@

set(_SHAFFT_PREFIX "${PACKAGE_PREFIX_DIR}")

macro(_shafft_set_and_check _var _file)
  set(${_var} "${_file}")
  if(NOT EXISTS "${_file}")
    message(FATAL_ERROR "File or directory ${_file} referenced by variable ${_var} does not exist !")
  endif()
endmacro()

include(CMakeFindDependencyMacro)

find_dependency(MPI REQUIRED)

set(SHAFFT_BACKEND_HIPFFT @SHAFFT_ENABLE_HIPFFT@)
set(SHAFFT_BACKEND_FFTW @SHAFFT_ENABLE_FFTW@)
set(SHAFFT_GPU_AWARE_MPI @SHAFFT_GPU_AWARE_MPI@)
set(SHAFFT_BUILD_FORTRAN @SHAFFT_BUILD_FORTRAN@)
set(SHAFFT_GPU_PLATFORM "@CMAKE_HIP_PLATFORM@")
set(SHAFFT_GPU_ARCHITECTURES "@CMAKE_HIP_ARCHITECTURES@")

if(SHAFFT_BACKEND_HIPFFT)
  set(HIP_PLATFORM "${SHAFFT_GPU_PLATFORM}")
  find_dependency(hip REQUIRED CONFIG)
  if(SHAFFT_GPU_PLATFORM STREQUAL "nvidia")
    include("${CMAKE_CURRENT_LIST_DIR}/HipNvidia.cmake")
  endif()
  find_dependency(hipfft REQUIRED CONFIG)
endif()

if(SHAFFT_BACKEND_FFTW)
  find_path(SHAFFT_FFTW_INCLUDE_DIR fftw3.h HINTS ${FFTW_INCLUDE_DIRS} REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/shafftTargets.cmake")
if(SHAFFT_BACKEND_FFTW)
  set_property(TARGET shafft::shafft_options APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES "${SHAFFT_FFTW_INCLUDE_DIR}")
endif()

set(SHAFFT_VERSION @PROJECT_VERSION@)
set(SHAFFT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(SHAFFT_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(SHAFFT_VERSION_PATCH @PROJECT_VERSION_PATCH@)

if(SHAFFT_BUILD_FORTRAN)
  set(_SHAFFT_MODULE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/shafft")
  string(REPLACE "${PACKAGE_PREFIX_DIR}" "${_SHAFFT_PREFIX}" _SHAFFT_MODULE_DIR "${_SHAFFT_MODULE_DIR}")
  _shafft_set_and_check(SHAFFT_Fortran_MODULE_DIR "${_SHAFFT_MODULE_DIR}")
endif()

check_required_components(shafft)
